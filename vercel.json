{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": ["api-src/**", "server/**", "shared/**"]
    },
    "api/draft.ts": {
      "includeFiles": ["shared/**"]
    }
  }
}
